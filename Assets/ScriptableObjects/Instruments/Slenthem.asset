  id: Slenthem
  displayName: Slenthem
  tagline: Balungan bernada paling rendah
  kelompok: Balungan
  laras: 2
  modelStandar: {fileID: 919132149155446097, guid: bcabfa923dc96034badb4a22dbe93521, type: 3}
  modelDetail: {fileID: 919132149155446097, guid: 5a7201151183aff46a300f8aafbb7c6a, type: 3}
