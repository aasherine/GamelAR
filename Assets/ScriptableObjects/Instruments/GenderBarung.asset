  id: GenderBarung
  displayName: Gender Barung
  tagline: Penghias melodi bernuansa lembut
  kelompok: Penghias melodi
  laras: 2
  modelStandar: {fileID: 919132149155446097, guid: 0c4aeb330205eed45abd79ef08c5dd28, type: 3}
