  id: BonangPenerus
  displayName: Bonang Penerus
  tagline: Penghias melodi satu oktaf lebih tinggi
  kelompok: Pencon
  laras: 2
  modelStandar: {fileID: 919132149155446097, guid: 377645103f8355f4a91a63a21f4f9533, type: 3}
  modelDetail: {fileID: 919132149155446097, guid: 3d525b8773a7d42488b6e652d3c5e3e1, type: 3}
