  id: SaronBarung
  displayName: Saron Barung
  tagline: Balungan satu oktaf di atas demung
  kelompok: Balungan
  laras: 2
  modelStandar: {fileID: 919132149155446097, guid: 8b2bbd6fde36d7a44a0a6d8a5515aed6, type: 3}
